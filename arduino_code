// ===== Redirect to Flask Server with Gateway Token =====
void handleRedirect() {
  // Check if Flask server is discovered
  if (flask_server_url == "" || !serverDiscovered) {
    // Show beautiful loading page while searching for server
    showLoadingPage();
    Serial.println("👤 Student connected - Showing loading page (server not ready)");
    return;
  }
  
  // Build redirect URL with gateway token
  String redirectUrl = flask_server_url;
  redirectUrl += "/?gateway_token=";
  redirectUrl += gateway_token;
  
  Serial.print("👤 Student connected - Redirecting to: ");
  Serial.println(redirectUrl);
  
  // Set gateway token in cookie
  String setCookieHeader = "gateway_token=";
  setCookieHeader += gateway_token;
  setCookieHeader += "; Max-Age=3600; Path=/";
  
  server.sendHeader("Set-Cookie", setCookieHeader, true);
  server.sendHeader("Location", redirectUrl, true);
  server.send(302, "text/plain", "Redirecting to attendance system...");
}