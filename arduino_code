#include <WiFi.h>
#include <DNSServer.h>
#include <WebServer.h>
#include <HTTPClient.h>

// ===== ESP32 Hotspot Settings =====
const char* hotspot_ssid = "ClassAttendance_Prof001";
const char* hotspot_password = "Class123";

// ===== Dynamic Flask Server Discovery =====
String flask_server_url = "";  // Will be discovered dynamically
const int FLASK_PORT = 5000;

// ===== Gateway Token (random, generated on startup) =====
String gateway_token = "";

// DNS and Web Server
DNSServer dnsServer;
WebServer server(80);
const byte DNS_PORT = 53;

// Discovery state
bool serverDiscovered = false;

// ===== Function Declarations =====
void generateGatewayToken();
void startHotspot();
void startDNSServer();
void startWebServer();
void discoverFlaskServer();
void handleRedirect();
bool pingFlaskServer(String url);
void showLoadingPage();

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n\n===== ESP32 Attendance Portal =====");
  
  // Generate unique gateway token on startup
  generateGatewayToken();
  
  // Start hotspot FIRST
  startHotspot();
  
  // Start DNS interception (before discovery, so captive portal works immediately)
  startDNSServer();
  
  // Start web redirect server (will show loading page while discovering)
  startWebServer();
  
  Serial.println("\n✓ ESP32 Web Server Ready - Students can connect now!");
  Serial.println("⏳ Discovering Flask server in background...");
  
  // Now discover Flask server (non-blocking for students)
  discoverFlaskServer();
  
  if (flask_server_url != "") {
    Serial.print("✓ Flask Server: ");
    Serial.println(flask_server_url);
    serverDiscovered = true;
  } else {
    Serial.println("⚠ Flask server not found yet. Showing loading page to students.");
  }
  
  Serial.print("\n✓ Gateway Token: ");
  Serial.println(gateway_token);
  Serial.println("\n===== System Ready =====\n");
}

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();
  
  // Periodically rediscover if server not found or check health (every 10 seconds)
  static unsigned long lastCheck = 0;
  if (millis() - lastCheck > 10000) {
    if (flask_server_url == "") {
      Serial.println("🔄 Retrying Flask server discovery...");
      discoverFlaskServer();
      if (flask_server_url != "") {
        serverDiscovered = true;
        Serial.println("✓ Flask server now available!");
      }
    } else if (!pingFlaskServer(flask_server_url + "/health")) {
      Serial.println("⚠ Flask server unreachable, rediscovering...");
      flask_server_url = "";
      serverDiscovered = false;
      discoverFlaskServer();
    }
    lastCheck = millis();
  }
  
  delay(10);
}

// ===== Discover Flask Server by Scanning Subnet =====
void discoverFlaskServer() {
  Serial.println("\n🔍 Discovering Flask server on subnet 192.168.4.x...");
  
  // Scan IPs from .2 to .20 (reasonable range)
  for (int i = 2; i <= 20; i++) {
    String testIP = "192.168.4." + String(i);
    String url = "http://" + testIP + ":" + String(FLASK_PORT);
    
    Serial.print("  Trying ");
    Serial.print(testIP);
    Serial.print("...");
    
    if (pingFlaskServer(url + "/health")) {
      flask_server_url = url;
      Serial.println(" ✓ FOUND!");
      Serial.print("✓ Flask server discovered at: ");
      Serial.println(flask_server_url);
      return;
    }
    Serial.println(" ✗");
    delay(50); // Small delay between attempts
  }
  
  Serial.println("⚠ Flask server not found in subnet. Will retry in 10 seconds.");
  flask_server_url = "";
}

// ===== Ping Flask Server Health Endpoint =====
bool pingFlaskServer(String url) {
  HTTPClient http;
  http.setTimeout(1500);  // 1.5 second timeout per attempt
  
  http.begin(url);
  int httpCode = http.GET();
  
  bool success = false;
  if (httpCode == 200) {
    String payload = http.getString();
    // Check if response contains "AttendEase" to verify it's our server
    if (payload.indexOf("AttendEase") >= 0 || payload.indexOf("attendease") >= 0) {
      success = true;
    }
  }
  
  http.end();
  return success;
}

// ===== Generate Random Gateway Token =====
void generateGatewayToken() {
  String characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
  
  gateway_token = "gw_";
  for (int i = 0; i < 32; i++) {
    int randomIndex = random(characters.length());
    gateway_token += characters[randomIndex];
  }
}

// ===== Start Hotspot =====
void startHotspot() {
  IPAddress local_ip(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(local_ip, gateway, subnet);
  WiFi.softAP(hotspot_ssid, hotspot_password);
  
  Serial.println("✓ Hotspot started!");
  Serial.print("  SSID: ");
  Serial.println(hotspot_ssid);
  Serial.print("  Password: ");
  Serial.println(hotspot_password);
  Serial.print("  Gateway IP: ");
  Serial.println(WiFi.softAPIP());
}

// ===== Start DNS Server =====
void startDNSServer() {
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
  Serial.println("✓ DNS Server started (Captive Portal Mode)");
}

// ===== Start Web Server =====
void startWebServer() {
  server.onNotFound(handleRedirect);
  server.begin();
  Serial.println("✓ Web Server started on port 80");
}

